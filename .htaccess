# SQLite のデータベースは store/ 以外に置かれていても Web から開かせない
# (store/ 以下は store/.htaccess ですべて拒否しています)
<FilesMatch "\.sqlite$">
	<IfModule mod_authz_core.c>
		# Apache 2.4 以降
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		# Apache 2.2
		Order Deny,Allow
		Deny from All
	</IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
	RewriteEngine On
	# store/ 以下は index.php に渡さず拒否する (store/.htaccess が効かない設定でも防ぐ)
	RewriteRule ^store(/|$) - [F]
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^(.+)$ /Megalopolis/index.php?path=$1 [QSA]
</IfModule>
