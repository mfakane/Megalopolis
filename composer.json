{
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "vimeo/psalm": "^6.10"
    },
    "autoload-dev": {
        "psr-4": { "Megalopolis\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:db": "bash compat/test.sh db",
        "test:compat": "bash compat/test.sh",
        "test:compat:full": "bash compat/test.sh full",
        "test:upgrade": "bash compat/upgrade.sh"
    },
    "autoload": {
		"psr-4": {
			"Megalopolis\\": "req/Core/"
		}
	},
    "require": {
        "vlucas/phpdotenv": "^5.6"
    }
}
