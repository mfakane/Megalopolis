<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="vendor/autoload.php" cacheDirectory=".phpunit.cache"
         failOnWarning="true" failOnRisky="true" failOnNotice="true" failOnDeprecation="true">
    <testsuites>
        <testsuite name="unit"><directory>tests/Unit</directory></testsuite>
        <testsuite name="database"><directory>tests/Database</directory></testsuite>
        <testsuite name="json"><directory>tests/JsonApi</directory></testsuite>
    </testsuites>
</phpunit>
