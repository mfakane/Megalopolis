{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>mfakane/renovate-config"
  ],
  "packageRules": [
    {
      "description": "compat/ and compose test/compat files reproduce legacy DB environments on purpose",
      "matchFileNames": [
        "compat/**",
        "compose.test.yml",
        "compose.compat.yml"
      ],
      "enabled": false
    }
  ]
}
